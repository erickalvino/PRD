| **Komentar** | `// KUSTOM erickalvino-XX: deskripsi` |

**Pola Form Request:**

```php
class MutationStoreRequest extends FormRequest
{
    public function authorize(): bool
    {
        return true; // Policy sudah handle otorisasi
    }

    public function rules(): array
    {
        $rules = [
            'field1' => 'required|integer|exists:table1,id',
            'field2' => 'required|string|max:255',
            'items' => 'required|array|min:1',
            'items.*.asset_id' => 'required|integer|exists:assets,id',
            'items.*.new_asset_tag' => [
                'required', 'string', 'max:255',
                Rule::unique('assets', 'asset_tag'),
            ],
        ];

        // Update mode: adjust unique rules jika perlu
        if ($this->isMethod('PUT') || $this->isMethod('PATCH')) {
            // ...
        }

        return $rules;
    }

    public function messages(): array
    {
        return [
            'field1.required' => 'Field 1 wajib diisi',
            'items.required' => 'Minimal harus memilih 1 aset',
            // ...
        ];
    }
}
