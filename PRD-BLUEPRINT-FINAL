|--------------------------------------------------------------------------
| KUSTOM erickalvino-AM: Asset Mutation Routes
|--------------------------------------------------------------------------
|
| Custom module AssetMutation - CRUD + ship/receive/reject routes (web)
|
*/
Route::group(['middleware' => ['auth']], function () {
    Route::resource('asset-mutations', \App\Http\Controllers\AssetMutations\AssetMutationsController::class, [
        'parameters' => ['asset-mutations' => 'assetMutation'],
    ])->names('assetMutations');

    Route::post('asset-mutations/{assetMutation}/ship', [AssetMutationsController::class, 'ship'])->name('assetMutations.ship');
    Route::post('asset-mutations/{assetMutation}/receive', [AssetMutationsController::class, 'receive'])->name('assetMutations.receive');
    Route::post('asset-mutations/{assetMutation}/reject', [AssetMutationsController::class, 'reject'])->name('assetMutations.reject');
    Route::post('asset-mutations/bulk/delete', [BulkAssetMutationsController::class, 'destroy'])->name('assetMutations.bulk.delete');
});
