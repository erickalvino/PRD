namespace App\Models;

use App\Models\Trails\Searchable;
use App\Presenters\Presentable;
use Illuminate\Database\Eloquent\Model;

class AssetMutation extends Model
{
    // KUSTOM erickalvino-AM — dokumentasi singkat modul

    use Presentable;
    use SoftDeletes;     // jika perlu soft delete

    protected $presenter = AssetMutationPresenter::class;

    protected $fillable = [
        'document_number',
        'origin_location_id',
        // ... semua field yang bisa di-mass assign
    ];

    protected $casts = [
        'is_insured' => 'boolean',
        'estimated_arrival_date' => 'date',
        'completed_date' => 'datetime',
    ];

    protected $appends = [
        'status_text',
        'total_items',
    ];

    // === RELATIONSHIPS ===
    public function originLocation(): BelongsTo { ... }
    public function destinationLocation(): BelongsTo { ... }
    public function items(): HasMany { ... }       // child items
    public function user(): BelongsTo { ... }

    // === SCOPES / ACCESSORS / MUTATORS ===
    public function getStatusTextAttribute(): string { ... }
    public function getTotalItemsAttribute(): int { ... }

    // === BOOT / EVENTS ===
    protected static function booted(): void
    {
        static::creating(function ($mutation) {
            // auto-generate document_number
        });
    }
}
```

